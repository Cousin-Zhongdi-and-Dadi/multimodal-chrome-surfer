{
  "manifest_version": 3,
  "name": "Multimodal Browser Agent",
  "version": "0.1.0",
  "description": "Chrome extension frontend for the local GenericAgent service.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "alarms",
    "nativeMessaging",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Multimodal Browser Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "120"
}
